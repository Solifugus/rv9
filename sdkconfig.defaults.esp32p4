# ESP32-P4 overrides. Applied after sdkconfig.defaults, which is C5-shaped.
#
# IDF reads sdkconfig.defaults.<target> on top of sdkconfig.defaults, so the
# C5 build is untouched by anything here.

# 32 MB, not the 4 MB the C5 line sets. The comment there is worth repeating
# one size up: get this wrong and the image header claims less than the board
# has, and the rest is unusable.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=n
CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y

# A table of its own; the C5's is sized for a twentieth of this chip.
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions-p4.csv"

# The console goes out through a CH343 wired to UART0, not through the chip's
# own USB Serial/JTAG -- that is a different connector on this board. The C5
# has no bridge, so there the programming cable IS the console.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=n
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_UART_NUM=0


# WHERE THE SPIKE GOT TO, 2026-10-05, so the next session does not re-run it.
#
# With RV-9's own kernel (the sdkconfig.defaults setting, unchanged here):
#
#   kal-test     45 / 45      conform 27 / 27      mod-test 17 / 17
#   io-test      41 passed,  1 FAILED
#   pub-test      4 passed, 14 FAILED
#   fault-test   10 passed, 26 FAILED
#   proc-test    panics: Illegal instruction, Core 0
#
# Two hypotheses tested and BOTH WRONG, which is worth more than the numbers:
#
#   1. Cache coherency. The panic's MTVAL is 0xA5C3A5C3 -- RV9K_STACK_PAINT,
#      RV-9's own kernel's paint -- so the fetch landed in painted memory, and
#      a split I/D cache would explain that. Implemented a ranged isync with
#      esp_cache_msync writeback + invalidate: IDENTICAL results, to the
#      millisecond. Reverted rather than kept, because an unproven change in a
#      kernel seam is the thing this project argues against. Ruled out, and
#      SOC_IRAM_LOW == SOC_DRAM_LOW on the P4 as on the C5, so the address is
#      legitimately executable either way.
#
#   2. That RV-9's own kernel is the weak part. Backed the KAL with FreeRTOS
#      instead to tell them apart, and it is the other way round:
#
#        FreeRTOS on P4:  kal-test 41 passed, 4 FAILED -- refuses to proceed
#        RV-9 kernel:     kal-test 45 / 45, six suites deep
#
#      The native kernel is the BETTER backend on this chip. FreeRTOS here is
#      SMP and the KAL's FreeRTOS backend assumes one core.
#
#   3. Instruction-cache coherency, properly this time. The P4 has one L1
#      I-cache PER CORE plus an L2, so Cache_WriteBack_All(L1_DCACHE|L2) then
#      Cache_Invalidate_All(L1_ICACHE_MASK) -- the ROM's own whole-cache ops,
#      which do work on internal RAM where esp_cache_msync declines it.
#      Identical results again.
#
#   4. The second core. CONFIG_FREERTOS_UNICORE=y, since RV-9's kernel is
#      single-core by construction. Identical results. Kept anyway: it is the
#      honest configuration for this kernel, not a fix.
#
#   5. Instruction set. Modules build as rv32imac_zicsr_zifencei_zaamo_zalrsc
#      and this target is rv32imafcb_..._xesploop_xespv -- a strict SUPERSET,
#      so the store's modules are portable and this is not it either. Worth
#      knowing in its own right: a module built for the C5 is legal here.
#
# WHAT IS KNOWN ABOUT THE FAULT, exactly, so nobody re-derives it:
#
#   loaded 'st-quick' rev 1, 56 bytes, resident at 0x4ffbebbc
#   about to enter 'st-quick': entry 0x4ffbebf0 holds 00008067
#   MEPC 0x4ffbebf0   MCAUSE 2 (illegal instruction)   MTVAL 0xA5C3A5C3
#
# The entry address is right: 0x4ffbebbc + 52 is the module's entry offset.
# The DATA read at that address returns 0x00008067, which is `ret` -- a
# perfectly legal instruction -- and it still reads correctly immediately
# before the call. The INSTRUCTION fetch at the same address gets
# 0xA5C3A5C3, which is RV9K_STACK_PAINT: the generation of that memory
# before the module was copied into it.
#
# THE ANSWER, found by taking RV-9 out of the question entirely.
#
# A bare probe in app_main: two instructions (`li a0,42` / `ret`) written into
# memory, read back through the data path, and called. No process, no
# scheduler, no module format. Three placements, and ALL THREE FAIL --
# including a plain `.bss` array:
#
#   probe .bss at 0x4ff38660: data reads 02a00513 00008067 -- calling
#   Guru Meditation Error: Core 0 panic'ed (Store access fault)
#   MEPC 0x4ff38660          <- the first instruction, and it is not a store
#
# So executing from data RAM does not work on this chip at all, and nothing
# above it was ever going to. The sdkconfig says why:
#
#   CONFIG_SOC_CPU_IDRAM_SPLIT_USING_PMP=y    <- a chip capability, not a knob
#
# The P4 splits instruction and data RAM with PMP, and IDF's startup marks the
# data side non-executable. CONFIG_ESP_SYSTEM_PMP_IDRAM_SPLIT, which
# sdkconfig.defaults sets to n, no longer exists -- it became
# CONFIG_ESP_SYSTEM_MEMPROT, which is already off and is not the same switch.
#
# WHICH IS THE WORK RV-9 ALREADY SAID IT WOULD DO. From sdkconfig.defaults,
# written before this board existed:
#
#   "This is not a permanent surrender of memory protection: in phase 7 RV-9
#    owns the PMP configuration and marks module regions executable
#    explicitly, which is stricter than this, not weaker."
#
# The C5 let that be deferred by having no split to turn off. The P4 does not.
# So the next piece of work is not a port detail: it is phase 7's PMP
# ownership, now due, and the module loader marking the region it just wrote
# as executable rather than asking the system to leave all of RAM that way.

# RV-9 own kernel is single-core by construction -- one s_current, one run
# queue. The P4 is the first dual-core chip it has met, and the second core
# was running IDF while RV-9 ran on the first. Take the chip down to one core
# until RV-9 has something to say about the second.
CONFIG_FREERTOS_UNICORE=y
