# ESP32-P4 overrides. Applied after sdkconfig.defaults, which is C5-shaped.
#
# IDF reads sdkconfig.defaults.<target> on top of sdkconfig.defaults, so the
# C5 build is untouched by anything here.

# 32 MB, not the 4 MB the C5 line sets. The comment there is worth repeating
# one size up: get this wrong and the image header claims less than the board
# has, and the rest is unusable.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=n
CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y

# A table of its own; the C5's is sized for a twentieth of this chip.
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions-p4.csv"

# The console goes out through a CH343 wired to UART0, not through the chip's
# own USB Serial/JTAG -- that is a different connector on this board. The C5
# has no bridge, so there the programming cable IS the console.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=n
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_UART_NUM=0


# WHAT THE BRING-UP SPIKE FOUND, 2026-10-05, so nobody spends the board time
# twice. RV-9 runs on this chip: it boots, 13 devices attach, modules load and
# execute, processes fork, and the shell comes up on /uart0.
#
# THE ONE REAL PORTING DEFECT was that freshly loaded module code would not
# execute. It cost five wrong hypotheses, so all of them are written down.
#
# The cause: this chip reaches internal RAM *through the L1 caches*
# (SOC_CACHE_INTERNAL_MEM_VIA_L1CACHE, true on the P4 and on no other chip
# RV-9 has met), and the L1 data cache is write-back. A module copied into
# RAM sits dirty in the data cache while the instruction cache still holds
# whatever was at that address before, and `fence.i` orders fetches without
# moving a single cache line. The C5 has no cache in front of internal RAM at
# all, which is why RV-9 got this far with fence.i alone.
#
# The symptom reads like a memory-permission fault and is not one:
#
#   loaded 'st-quick' rev 1, 56 bytes, resident at 0x4ffbebbc
#   about to enter 'st-quick': entry 0x4ffbebf0 holds 00008067
#   MEPC 0x4ffbebf0   MCAUSE 2 (illegal instruction)   MTVAL 0xA5C3A5C3
#
# The data read returns 0x00008067 -- `ret`, correct -- right up to the call.
# The instruction fetch gets 0xA5C3A5C3, which is RV9K_STACK_PAINT: the
# generation of that memory before the module was copied into it. The data
# side is right and the instruction side is one cache generation behind.
#
# The fix is in rv9_isync(), which now takes the range that was written and,
# on this target, writes it back and invalidates it before the fence. It
# lives in components/rv9_kal/src/kal_mem.c, built under either kernel,
# because it is a property of this board's memory and not of the scheduler.
#
# FIVE HYPOTHESES THAT WERE WRONG, and why each was discarded:
#
#   1. "Cache coherency" -- right family, wrong implementation. A ranged
#      esp_cache_msync writeback+invalidate changed nothing to the
#      millisecond. Reverted rather than kept. In hindsight the idea was
#      correct and the call was not: see dead end 3.
#
#   2. "RV-9's own kernel is the weak part." Backed the KAL with FreeRTOS to
#      tell them apart, and it is the other way round:
#
#        FreeRTOS on P4:  kal-test 41 passed, 4 FAILED -- refuses to proceed
#        RV-9 kernel:     kal-test 45 / 45, every suite deep
#
#      The native kernel is the BETTER backend on this chip. FreeRTOS here is
#      SMP and the KAL's FreeRTOS backend assumes one core.
#
#   3. Whole-cache ROM operations -- Cache_WriteBack_All then
#      Cache_Invalidate_All. Identical results, and this is the one that
#      wasted the most time: the code was put in kal_freertos.c while the
#      board was running the NATIVE backend, so it never executed. The fix
#      now lives in kal_mem.c, which is compiled either way, specifically so
#      that cannot happen again.
#
#   4. The second core. CONFIG_FREERTOS_UNICORE=y. Identical results. Kept
#      anyway: it is the honest configuration for a kernel with one run
#      queue, not a fix.
#
#   5. Instruction set. Modules build as rv32imac_zicsr_zifencei_zaamo_zalrsc
#      and this target is rv32imafcb_..._xesploop_xespv -- a strict SUPERSET,
#      so a module built for the C5 is legal here. Worth knowing in its own
#      right.
#
#   6. PMP / PMA. An earlier commit here concluded that
#      CONFIG_SOC_CPU_IDRAM_SPLIT_USING_PMP=y meant IDF marks data RAM
#      non-executable. THAT CONCLUSION WAS WRONG and is retracted. Reading
#      esp_hw_support/port/esp32p4/cpu_region_protect.c: with MEMPROT off
#      (`# CONFIG_ESP_SYSTEM_MEMPROT is not set`) and rev >= v3 (this board
#      is v3.2, CONFIG_ESP_REV_MIN_FULL=301), PMP entries 4-7 cover
#      SOC_IRAM_LOW..SOC_IRAM_HIGH with CONDITIONAL_RWX -- read, write AND
#      execute -- for both the cached and non-cached views, and PMA entry 13
#      whitelists the same range as PMA_RWX. Neither forbids execution.
#      A bare probe settled it: two instructions (`li a0,42` / `ret`) written
#      into a .bss array, written back, invalidated, fenced, and called --
#      returns 42. Internal RAM on the P4 is executable.
#
# WHAT IS STILL FAILING, which is a different kind of work -- none of it is
# about code execution any more:
#
#   io-test     41 passed,  1 FAILED   -- /term: no LCD console on this board
#   fault-test  73 passed,  3 FAILED   -- all three are network: no radio here
#   mem-test    12 passed,  1 FAILED   -- exhaustion test, sized for the C5
#   sched-test   8 passed,  7 FAILED   -- real-time admission, see below
#
# The sched failures are the interesting ones and are NOT a cache problem.
# They include refusals that did not happen ("a loop that fits the CPU but
# not the deadlines is refused"), which means admission control let in work
# it should have turned away. Admission arithmetic calibrated against a
# 240 MHz C5 does not transfer to a 400 MHz P4 by itself. That is the next
# piece of real-time work, and it is a design question, not a port detail.
#
# Phase 7's PMP ownership is still worth doing -- RV-9 marking module regions
# executable explicitly is stricter than leaving all of RAM that way -- but it
# is no longer a blocker for this board, and it never was the reason modules
# would not run.

# RV-9 own kernel is single-core by construction -- one s_current, one run
# queue. The P4 is the first dual-core chip it has met, and the second core
# was running IDF while RV-9 ran on the first. Take the chip down to one core
# until RV-9 has something to say about the second.
CONFIG_FREERTOS_UNICORE=y
