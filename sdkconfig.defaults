# Board is 4MB; without this the image header claims 2MB and half is unusable.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# RV-9 does its own scheduling above the KAL; a 1ms tick keeps the mapping
# between RV-9 time and kernel time simple.
CONFIG_FREERTOS_HZ=1000

# The module store needs a partition of its own.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# ESP-IDF uses PMP to mark data RAM non-executable. The module loader copies
# module code into heap memory and jumps to it, so that split has to go.
#
# This is not a permanent surrender of memory protection: in phase 7 RV-9
# owns the PMP configuration and marks module regions executable explicitly,
# which is stricter than this, not weaker. Until then we have no protection
# from a misbehaving module -- which is fine, because we wrote all of them.
CONFIG_ESP_SYSTEM_PMP_IDRAM_SPLIT=n

# RV-9 processes are CPU-bound by design in phase 2, which upsets the idle
# task watchdog. Supervision is the OS's job, not the host kernel's -- RV-9
# grows its own in a later phase.
CONFIG_ESP_TASK_WDT_INIT=n

# The console must be the native USB Serial/JTAG, not UART0. UART0's pins go
# nowhere on this board, and RV-9 needs the USB link for input as well as
# output -- it is the only terminal the board has.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
