# Board is 4MB; without this the image header claims 2MB and half is unusable.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# RV-9 does its own scheduling above the KAL; a 1ms tick keeps the mapping
# between RV-9 time and kernel time simple.
CONFIG_FREERTOS_HZ=1000

# The module store needs a partition of its own.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# ESP-IDF uses PMP to mark data RAM non-executable. The module loader copies
# module code into heap memory and jumps to it, so that split has to go.
#
# This is not a permanent surrender of memory protection: in phase 7 RV-9
# owns the PMP configuration and marks module regions executable explicitly,
# which is stricter than this, not weaker. Until then we have no protection
# from a misbehaving module -- which is fine, because we wrote all of them.
CONFIG_ESP_SYSTEM_PMP_IDRAM_SPLIT=n

# RV-9 processes are CPU-bound by design in phase 2, which upsets the idle
# task watchdog. Supervision is the OS's job, not the host kernel's -- RV-9
# grows its own in a later phase.
CONFIG_ESP_TASK_WDT_INIT=n

# The console must be the native USB Serial/JTAG, not UART0. UART0's pins go
# nowhere on this board, and RV-9 needs the USB link for input as well as
# output -- it is the only terminal the board has.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# The C5 has a hardware stack guard that faults when the stack pointer
# leaves the running task's registered range. RV-9's own scheduler switches
# to thread stacks the host kernel has never registered, so the first
# context switch trips it.
#
# This is not a protection RV-9 is giving up -- it is the same class of
# mechanism RV-9 wants for itself. While the kernel is a guest it cannot
# describe its stacks to a guard the host owns; once it owns the CPU
# (phase 7 step 3) it programs the guard per thread, and PMP after that.
CONFIG_ESP_SYSTEM_HW_STACK_GUARD=n

# RV-9's kernel tick must fire even while the host scheduler is suspended,
# so it needs a callback dispatched from the interrupt rather than from a
# task that cannot be scheduled.
CONFIG_ESP_TIMER_SUPPORTS_ISR_DISPATCH_METHOD=y

# Run RV-9 on RV-9's own kernel: processes, I/O and the shell are all
# scheduled by rv9_kernel rather than by FreeRTOS, which is left holding
# one task for the kernel to live in. Set to n for the FreeRTOS reference.
CONFIG_RV9_KERNEL_NATIVE=y

# A pin must be reachable while the flash cache is off.
#
# RV9_RT_CODE puts RV-9's own write path in IRAM, but the last two calls in
# it belong to ESP-IDF, and by default they live in flash like everything
# else -- so a control loop that reached gpio_set_level during a flash write
# would have found it missing. This moves gpio_set_level and gpio_get_level
# into IRAM, which is what makes "a pin is the one device a control loop can
# drive through a flash write" actually true rather than nearly true.
CONFIG_GPIO_CTRL_FUNC_IN_IRAM=y

# RV-9 keeps each task's path table in thread-local storage so that reading
# or writing a path costs a dereference rather than a lock and a search.
# Index 0 belongs to ESP-IDF's pthread support, so RV-9 uses index 1 and
# there must be room for it.
CONFIG_FREERTOS_THREAD_LOCAL_STORAGE_POINTERS=2
