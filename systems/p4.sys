# The Waveshare ESP32-P4 bench board, with everything it has.
#
# Built by tools/mksystem.py systems/p4.sys into build-p4/. The same firmware
# as a plain `idf.py build` with the defaults, which is everything on.

target="esp32p4"

# CONFIG_RV9_DRV_<NAME>, by name. Every driver not named is left out; the
# console, /f0, /pub0 and pipes are always there.
drivers="lcdcon svgwin touch sdcard ramdisk net ssh gpio pwm adc tsens i2c audio camera tts"

# The self-tests, run when /f0/selftest asks. "yes" puts the `tests` group
# in the store as well, because the suites fork those.
selftest="yes"

# Groups or module names (tools/build_modules.sh --store). The rest are
# built and kept for the card.
store="all"

# Commands for the card instead, in the same words; they run from /sd0/cmd/
# when asked for. The card also gets the files that what this system
# carries reads (each build.conf's `files`): tools/mksystem.py --install.
card=""
